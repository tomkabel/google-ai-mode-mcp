{
  "name": "@tomkabel/google-ai-mode-mcp",
  "version": "1.1.0",
  "description": "MCP server that plugs any LLM into Google AI Mode for free, cited, token-efficient web research \u2014 Patchright + persistent profile, content-stable completion detection, machine-readable ok/degraded/failed status, multi-language (incl. Estonian) support.",
  "type": "module",
  "bin": {
    "google-ai-mode-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "watch": "tsc --watch",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check:code && npm run check:harness && npm run check:publish-posture",
    "check:code": "tsc --noEmit && vitest run",
    "check:publish-posture": "node scripts/check-publish-posture.mjs",
    "check:publish-posture:mutate": "node scripts/check-publish-posture.mjs --mutate",
    "smoke": "npm run build && node tests/smoke.mjs",
    "check:harness": "node scripts/check-harness-wiring.mjs --deep",
    "check:harness:spawn": "node scripts/check-harness-wiring.mjs --deep --spawn --require-all",
    "check:harness:selftest": "node scripts/selftest-harness-wiring.mjs",
    "check:orphans": "node scripts/check-orphan-mcp.mjs --min-cpu 5",
    "prepublishOnly": "npm run check:code",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google",
    "google-ai-mode",
    "ai-search",
    "web-research",
    "claude",
    "claude-code",
    "citations",
    "browser-automation",
    "patchright",
    "cursor",
    "cline",
    "windsurf",
    "hermes-agent",
    "pi-package"
  ],
  "author": "G\u00e9r\u00f4me Dexheimer <hello@geromedexheimer.de> (https://github.com/PleasePrompto)",
  "contributors": [
    "Tom Kristian Abel (fork maintainer: https://github.com/tomkabel)"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomkabel/google-ai-mode-mcp.git"
  },
  "homepage": "https://github.com/tomkabel/google-ai-mode-mcp#readme",
  "bugs": {
    "url": "https://github.com/tomkabel/google-ai-mode-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.0",
    "env-paths": "^3.0.0",
    "patchright": "^1.48.2",
    "turndown": "^7.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "markdown-it": "^15.0.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
